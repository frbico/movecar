# No .env file is required: ./install.sh starts immediately.
# Optional Docker port settings (set as shell variables or in an .env file):
HOST_BIND=0.0.0.0
HOST_PORT=8888
# All notification settings are configured in /admin and stored in SQLite.

# Optional WebRTC (set on your Docker host, never commit a real shared secret):
# STUN_URLS=stun:stun.example.org:3478
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# TURN_SHARED_SECRET=your-long-random-secret-matching-coturn
