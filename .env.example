# No .env file is required: ./install.sh starts immediately.
# Optional Docker port settings (set as shell variables or in an .env file):
HOST_BIND=0.0.0.0
HOST_PORT=8888
# All notification settings are configured in /admin and stored in SQLite.

# Optional anonymous voice calling. Keep pairing/Firebase secrets out of Git.
# VOICE_PAIRING_SECRET=at-least-32-random-characters
# Recommended: host STUN/TURN in Hong Kong and Tokyo, under your own domain.
# VOICE_STUN_URLS=stun:turn-hk.example.com:3478,stun:turn-tokyo.example.com:3478
# VOICE_TURN_URLS=turn:turn-hk.example.com:3478?transport=udp,turn:turn-hk.example.com:3478?transport=tcp,turns:turn-hk.example.com:443?transport=tcp,turn:turn-tokyo.example.com:3478?transport=udp
# VOICE_TURN_SHARED_SECRET=another-long-random-secret
